// Comprobantes de proveedores: facturas, remitos, tickets y notas.
//
// Vive en su propia base, aparte del stock, por tres razones: el respaldo del
// stock retiene 14 días y un comprobante fiscal hay que guardarlo años;
// restaurar un período de pedidos jamás debe poder tocar una factura; y los
// ciclos de vida no se parecen — el inventario se resetea, un comprobante no
// se toca nunca más.
//
// No hay claves foráneas hacia la base del stock. Los ids de usuario viajan
// con el nombre al lado, como ya hace `Suggestion`.

generator client {
  provider = "prisma-client"
  output   = "../../app/generated/comprobantes"
}

datasource db {
  provider = "sqlite"
}

/// A nombre de QUIÉN está la factura.
///
/// **Por qué existe.** El módulo nació asumiendo una sola empresa, con el CUIT
/// escrito en el código. Después apareció la UTE de los Juegos Suramericanos
/// —Soluciones para Eventos + Transfluvial—, que es **otro contribuyente**: su
/// propio CUIT, su propia clave fiscal y su propio libro de IVA.
///
/// Sin esto las facturas de las dos entidades comparten la deuda por proveedor
/// y la pantalla de pagos. No es un problema de prolijidad: es un total que
/// suma dos contribuyentes y que no le sirve a ninguno de los dos.
///
/// Se dan de alta desde la app y no desde el código, para que sumar una tercera
/// o corregir un dígito no dependa de un despliegue.
model Entidad {
  id     String @id @default(cuid())
  nombre String
  /// La identidad real. Es contra esto que se compara el `nroDocRec` del QR de
  /// AFIP para saber de quién es la factura sin que nadie elija nada.
  cuit   String @unique

  activa    Boolean   @default(true)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  documents Document[]
  ingresos  EventoIngreso[]
}

// Un proveedor. El CUIT es la identidad real; el nombre en el papel varía
// ("DON ANGEL", "Don Angel SRL", "DONANGEL") y no sirve para identificar.
model Supplier {
  id        String     @id @default(cuid())
  name      String
  // Único cuando existe. NULL = proveedor informal sin CUIT (verdulería,
  // ferretería de barrio). SQLite admite varios NULL en un índice único.
  cuit      String?    @unique
  alias     String?
  // --- La condición de pago que se pactó con este proveedor ---
  //
  // **Es un acuerdo, no un dato que se copia de un papel.** Alguien lo negoció,
  // y dentro de seis meses alguien va a preguntar "¿desde cuándo le pagamos a
  // 30 días?". Por eso no alcanza con el número: van también quién lo cargó y
  // cuándo.
  //
  // Días para pagar, contados desde la emisión de la factura. Sirve para
  // PROPONER el vencimiento; si el papel trae una fecha, gana la fecha.
  //
  // Los tres estados salen de las dos columnas juntas, sin columna de estado:
  //
  //   acordadaAt NULL                    → nadie contestó todavía (falta)
  //   acordadaAt + diasPago 0            → contado, se paga contra entrega
  //   acordadaAt + diasPago N            → a N días
  //   acordadaAt + diasPago NULL         → se acordó que NO hay plazo fijo
  //   acordadaAt + debitoAutomatico      → la plata sale sola de la cuenta
  //
  // El comentario anterior decía que NULL era "contado o no se sabe". Son dos
  // cosas distintas: contado es cero días y una decisión tomada; no se sabe es
  // un hueco. Confundirlas hacía que un proveedor de contado y uno sin cargar
  // se vieran igual, que es justo lo que esta pantalla viene a resolver.
  diasPago  Int?
  /// **La plata sale sola de la cuenta**: seguros, leasing, luz, gas, internet.
  ///
  /// No es un plazo, es otra forma de pagar, y por eso no es un `diasPago` más:
  /// no hay fecha que proponer porque no hay nada que decidir. Sus comprobantes
  /// salen de las listas de "qué pagar" —nadie los paga— pero se cuentan
  /// aparte, porque la plata sale igual y el IVA sigue siendo crédito fiscal.
  ///
  /// Hoy nadie cruza el débito contra la factura: se ve en el extracto y se
  /// asume que está bien. Eso es lo que resolvería la conciliación bancaria,
  /// que ya está en este esquema y todavía no la usa nadie.
  debitoAutomatico Boolean @default(false)
  /// Cuándo se registró la condición. NULL = nadie la cargó todavía.
  condicionAcordadaAt DateTime?
  /// Quién la registró. Va el nombre al lado del id, como en `DocumentChange`:
  /// esta base no tiene claves foráneas hacia la de usuarios.
  condicionAcordadaPorId   String?
  condicionAcordadaPorName String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  deletedAt DateTime?
  documents Document[]
}

model Document {
  id   String @id @default(cuid())
  kind String // FACTURA | REMITO | TICKET | NOTA_CREDITO | NOTA_DEBITO | OTRO

  // Cómo se resolvió la cabecera la primera vez, no de dónde salió la foto.
  // Un valor por peldaño de la cascada:
  //   ARCA | QR | EMPAREJADO | LECTURA | MANUAL
  // Sirve además como medición: en producción dice qué peldaño está
  // funcionando de verdad, que es hoy el número más incierto del proyecto.
  source String

  // --- Identidad fiscal. Se copia de un código o de ARCA; NUNCA se tipea. ---
  cuitEmisor   String?
  tipoCbte     String?
  puntoVenta   Int?
  numero       Int?
  fechaEmision String? // "AAAA-MM-DD"
  importeTotal BigInt? // CENTAVOS, siempre positivo
  // El desglose que el lector ya calcula para verificar que la cuenta cierre.
  // Sin esto no se puede armar el Libro IVA Compras y el crédito fiscal —que es
  // plata— hay que volver a sacarlo del papel.
  neto         BigInt? // CENTAVOS
  iva          BigInt? // CENTAVOS
  percepciones BigInt? // CENTAVOS
  // Se guarda para poder RECHAZAR lo que no sea PES. No hay multimoneda: acá se
  // compra comida en Santa Fe, en pesos. Una factura en dólares entraría con su
  // importe tratado como si fueran pesos.
  moneda       String? @default("PES")
  cae          String?
  // Se guarda pero NO se le muestra a quien paga: es la fecha que ya se
  // confundió una vez con el vencimiento del pago.
  caeVence     String?

  // --- Vínculos, corregibles sin tocar el dato crudo ---
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  // A nombre de quién está: Soluciones para Eventos, la UTE, o la que venga.
  //
  // NULL = no se sabe de quién es. Es distinto de asumir la de siempre, y por
  // eso la columna es opcional: un comprobante sin QR, cargado a las apuradas,
  // puede quedar sin entidad hasta que alguien la ponga. La pantalla lo muestra
  // como lo que es en vez de esconderlo adentro de un total.
  entidadId String?
  entidad   Entidad? @relation(fields: [entidadId], references: [id])

  // A dónde entró la mercadería. La factura NO pertenece a una fiesta.
  destino     String? // COCINA | DEPOSITO | OTRO
  destinoNota String?

  // NULL = nadie revisó. Distinto de "revisado y estaba bien".
  conforme      Boolean?
  faltantesNota String?

  // Sale del "Vto:" del papel. NUNCA se autocompleta desde el CAE.
  vencimiento String?
  pagadoAt    DateTime?
  // Qué comprobantes se marcaron juntos en una misma operación. No es una
  // entidad "pago" —eso viene después— pero convierte la migración futura de
  // "adivinar qué facturas iban en cada transferencia" en "leerlo".
  pagoLoteId  String?

  // NULL = todavía no se cruzó contra ARCA.
  enArca Boolean?

  // Los tres van en NULL cuando el comprobante entró por el CSV de ARCA: no lo
  // capturó nadie. Que `capturedByName` esté vacío es información, no un hueco.
  capturedById   String?
  capturedByName String?
  clientKey      String?   @unique
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  // Cuando una foto suelta se empareja con una fila de ARCA, las fotos se
  // mudan y esta fila queda borrada apuntando a la que quedó viva.
  mergedIntoId String?

  attachments Attachment[]
  lines       DocumentLine[]
  changes     DocumentChange[]
  capturas    CapturaVista[]

  // Los cuatro campos juntos son la identidad de una factura electrónica
  // argentina. Es lo que impide cargar dos veces la misma, venga por foto o
  // por ARCA. Los remitos y tickets van en NULL y no deduplican, que es lo
  // correcto: no tienen identidad única.
  // La identidad fiscal NO lleva la entidad adentro: una factura electrónica
  // argentina es única por emisor + tipo + punto de venta + número en todo el
  // país. Dos contribuyentes no pueden recibir la misma.
  @@unique([cuitEmisor, tipoCbte, puntoVenta, numero])
  @@index([entidadId, pagadoAt])
  @@index([supplierId, pagadoAt])
  @@index([pagoLoteId])
  @@index([vencimiento, pagadoAt])
  @@index([deletedAt])
}

// Las llaves de captura que ya se procesaron.
//
// `Document.clientKey` solo guarda la llave de la captura que CREÓ el
// documento. Cuando una captura se fusiona contra un comprobante que ya existía,
// su llave no quedaba en ningún lado — y un reintento con esa misma llave
// volvía a adjuntar las mismas fotos. Acá viven todas.
model CapturaVista {
  clientKey  String   @id
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([documentId])
}

// Una foto, o varias: la factura de tres hojas. El archivo vive en S3.
model Attachment {
  id           String   @id @default(cuid())
  // ORIGINAL = la foto tal como salió de la cámara.
  // ESCANEADA = la misma, recortada al borde del papel, enderezada y con el
  // fondo blanqueado. Es la que se muestra y la que se archiva.
  //
  // Se guardan LAS DOS. Un recorte automático mal hecho puede comerse el CAE o
  // un renglón entero, y de la escaneada eso no se recupera: la original es el
  // seguro.
  variante     String   @default("ORIGINAL")
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  s3Key        String   @unique
  mimeType     String
  sizeBytes    Int
  page         Int      @default(1)
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([documentId, page])
}

// Un renglón de la factura. Es lo que convierte un comprobante en algo que se
// puede preguntar: "cuánto pagamos por queso reggianito en seis meses".
//
// Los importes van en centavos como todo lo demás. `cantidad` va en MILÉSIMAS
// —"4,40 KG" es 4400— porque las cantidades traen decimales y el mismo
// argumento del punto flotante vale acá.
//
// El detalle además VERIFICA la cabecera: cada renglón cumple
// `cantidad × precio = subtotal`, y la suma de todos da el subtotal general.
// Con el detalle adentro el documento queda sobredeterminado, así que un dígito
// mal leído rompe alguna de esas cuentas y se nota.
model DocumentLine {
  id             String   @id @default(cuid())
  documentId     String
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  orden          Int      // el orden en que aparecen en el papel
  codigo         String?  // el código del proveedor, si lo trae
  descripcion    String
  // La regla de unidades de esta tabla, que NO es la del resto del módulo:
  //
  //   cantidades y precios unitarios  ->  MILÉSIMAS
  //   importes                        ->  CENTAVOS
  //
  // Porque un precio unitario **no es un importe, es una tasa**: una factura
  // real de carnicería imprime el kilo a "31.574,674", con tres decimales,
  // porque el precio se multiplica por la cantidad y recién ahí se redondea.
  // Guardarlo en centavos obligaba a redondear el dato impreso, y el documento
  // reconstruido dejaba de coincidir con el papel en esa columna.
  cantidad       BigInt?  // MILÉSIMAS: 4,40 KG = 4400
  unidad         String?  // KG | UN | LT | ...
  precioUnitario BigInt?  // MILÉSIMAS de peso: $13.607,240 = 13607240
  subtotal       BigInt?  // CENTAVOS, tal como está impreso

  @@index([documentId, orden])
  @@index([descripcion])
}

/**
 * Una importación del CSV de ARCA (*Mis Comprobantes → Recibidos*).
 *
 * Guarda el hash del archivo para detectar que se subió el mismo dos veces
 * antes de parsearlo. **No es lo que da la idempotencia** —eso lo da la clave
 * fiscal de cuatro campos de `Document`, que hace que reimportar un período
 * solapado sea inofensivo— pero ahorra el trabajo y evita el susto de ver
 * "0 nuevos" sin entender por qué.
 *
 * Los contadores se guardan porque son la única forma de contestar después
 * "¿cuántas facturas aparecieron que nadie había traído?", que es la pregunta
 * que motivó todo esto.
 */
model ArcaImport {
  id        String  @id @default(cuid())
  entidadId String
  archivo   String
  /** Hash del contenido: el mismo archivo dos veces se detecta antes de parsear. */
  hashArchivo String

  filasLeidas   Int
  /** Ya estaban cargadas y se completaron con el dato del fisco. */
  completadas   Int
  /** ARCA las conoce y nadie había traído el papel. */
  creadas       Int
  /** Tenemos el papel y ARCA no las conoce, dentro del período importado. */
  sinRespaldo   Int
  /** Campos donde ARCA difiere de algo que una persona había corregido a mano.
   *  No se pisan: se cuentan y quedan en el historial. */
  discrepancias Int

  /** El período que cubre, derivado de las filas y no de lo que diga nadie. */
  desde String?
  hasta String?

  actorId   String?
  actorName String
  createdAt DateTime @default(now())

  @@index([entidadId, createdAt])
}

// Historial campo por campo. Mismo patrón que ProductChange en la otra base.
model DocumentChange {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actorId    String?
  actorName  String
  field      String
  before     String?
  after      String?
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt])
}

// ===========================================================================
// Capa bancaria
// ===========================================================================
//
// Se investigó qué ofrece Banco Macro y el resultado es que **no hay API
// pública para pymes**. El patrón argentino es que el home banking entrega
// PDF; existe una industria entera de conversores de extractos de Macro, que es
// la mejor evidencia de eso. Interbanking/DATANET sí entrega archivos
// estructurados, pero exige adhesión y no está confirmado que la empresa la
// tenga.
//
// Por eso acá NO hay ningún parser: hay un modelo y una frontera. El formato
// concreto se escribe cuando exista un archivo real, igual que se hizo con los
// QR — el lector de QR se escribió contra payloads reales y por eso soporta los
// que vienen rotos. Escribirlo antes sería adivinar.

/** Una cuenta bancaria. El banco es un dato, no una estructura: cambiar de
 *  banco no debería tocar el módulo financiero. */
model BankAccount {
  id        String   @id @default(cuid())
  banco     String // MACRO | GALICIA | ...
  alias     String
  cbu       String?
  moneda    String   @default("ARS")
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())

  movimientos BankMovement[]

  @@unique([banco, alias])
}

/**
 * Un movimiento del extracto.
 *
 * `huella` es lo que impide que reimportar el mismo período duplique todo. Los
 * extractos se bajan por rango y los rangos se pisan; sin idempotencia el saldo
 * se va al doble. Es el mismo argumento que la `clientKey` de la captura.
 *
 * Cuando el archivo trae un identificador propio del banco se usa ese; cuando
 * no, la huella se calcula de forma determinística sobre los campos de la fila
 * más su posición dentro del día — dos movimientos idénticos el mismo día son
 * legítimos y tienen que poder convivir.
 */
model BankMovement {
  id        String      @id @default(cuid())
  accountId String
  account   BankAccount @relation(fields: [accountId], references: [id])

  fechaContable String // "AAAA-MM-DD": se concilia por día, no por instante
  fechaValor    String?
  // Tal cual la imprime el banco. NUNCA se normaliza encima: la descripción
  // cruda es lo que después permite escribir reglas de clasificación.
  descripcion   String
  referencia    String?
  // CON SIGNO: acá el signo sí es del banco. Es la diferencia con los
  // comprobantes, donde el signo lo decide el tipo.
  importe       BigInt
  // El saldo posterior, cuando el archivo lo trae. Es un control que no cuesta
  // nada: si `saldo[n-1] + importe[n] == saldo[n]` para toda la secuencia, el
  // import está completo y ordenado. Si en algún punto no cierra, FALTA una
  // fila y el sistema lo sabe sin que nadie mire.
  saldoPosterior BigInt?

  /** Id propio del banco, si el archivo lo trae. */
  idExterno String?
  /** Huella determinística de la fila. Es la que impide el duplicado. */
  huella    String  @unique
  /** Qué adaptador lo importó: "macro-csv", "interbanking-datanet"... */
  origen    String
  loteId    String

  // PENDIENTE | SUGERIDO | CONCILIADO | CONFLICTO | IGNORADO
  estado    String  @default("PENDIENTE")
  // Obligatoria al ignorar: IMPUESTO_25413 | SIRCREB | COMISION | IVA_COMISION
  // | TRASPASO_PROPIO | INTERES | OTRO. Un "ignorado" sin categoría es donde va
  // a morir todo lo que nadie entiende.
  categoria String?

  importadoAt DateTime @default(now())

  @@index([accountId, fechaContable])
  @@index([estado])
  @@index([loteId])
}

/** Una importación. Permite deshacer un archivo entero mientras ninguna de sus
 *  filas esté conciliada — mucho más seguro que borrar movimiento por
 *  movimiento. */
model BankImport {
  id        String   @id @default(cuid())
  accountId String
  origen    String
  archivo   String
  /** Hash del archivo: subir el mismo dos veces se detecta antes de parsear. */
  hashArchivo String
  filasLeidas    Int
  filasNuevas    Int
  filasRepetidas Int
  desde     String?
  hasta     String?
  actorId   String?
  actorName String
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
}

// ===========================================================================
// El otro lado del margen: lo que se le cobra al cliente
// ===========================================================================

/// Lo pactado con el cliente por un evento.
///
/// **Por qué vive acá y no en `Event`.** El evento está en la base del stock,
/// cuyo respaldo retiene 14 días porque los pedidos se resetean. Esto es plata,
/// y la plata se conserva años — el mismo motivo por el que los comprobantes
/// tienen su propia base. Además el margen se calcula donde están los costos.
///
/// **`eventoId` NO es una clave foránea**: cruza bases, como los ids de usuario
/// que ya viajan con el nombre al lado. Por eso se copian `lugar` y `fecha`: la
/// fila se tiene que poder leer sola, y si alguien borra el evento del pedido
/// el registro de lo que se cobró no puede desaparecer con él.
///
/// **El ingreso es lo PACTADO, no lo cobrado.** Es lo que contesta si el evento
/// fue buen negocio; si el cliente pagó o no es otra pregunta, y mezclarlas
/// haría que un evento excelente todavía impago diera margen negativo.
model EventoIngreso {
  id       String @id @default(cuid())
  eventoId String @unique
  /// Copiados del evento al guardar, para que esta fila se lea sola.
  lugar    String
  fecha    String // "AAAA-MM-DD"

  /// A nombre de qué contribuyente se factura. Sin esto, el margen mezclaría
  /// dos empresas, igual que lo haría la deuda.
  entidadId String?
  entidad   Entidad? @relation(fields: [entidadId], references: [id])

  /// CENTAVOS. El precio del cubierto.
  precioPorPersona BigInt?
  /// **Por cuántos se cobra**, que NO es la cantidad de invitados del evento.
  /// Es un mínimo garantizado: si vienen menos, se cobra igual lo presupuestado.
  /// Confundirlo con `Event.guests` daría un ingreso más chico que el real.
  comensales Int?
  /// Si el precio pactado ya tiene el IVA adentro. Depende del cliente: a una
  /// empresa se le factura A con IVA discriminado, a un particular B con el IVA
  /// incluido. NULL = nadie contestó todavía, que no es lo mismo que "no".
  conIva Boolean?

  extras EventoExtra[]

  /// Quién lo cargó y cuándo. Un precio pactado es una decisión de alguien.
  cargadoPorId   String?
  cargadoPorName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([fecha])
}

/// Un extra de importe fijo: los kioscos, o algo puntual que pidió el cliente.
///
/// Es una tabla y no un campo "extras" con un número, porque puede haber varios
/// y cada uno tiene su precio. Un solo total perdería qué se cobró.
model EventoExtra {
  id          String        @id @default(cuid())
  ingresoId   String
  ingreso     EventoIngreso @relation(fields: [ingresoId], references: [id], onDelete: Cascade)
  descripcion String
  /// CENTAVOS, fijo: no depende de la cantidad de gente.
  importe     BigInt
  orden       Int           @default(0)

  @@index([ingresoId, orden])
}
