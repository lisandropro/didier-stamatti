// Modelo de datos — App de control de stock Didier Stamatti Catering
// Reglas clave:
// - Reutilizables (enseres/mobiliario) llevan stock; consumibles (bebida/insumos) no.
// - Control por fin de semana: la suma de un producto entre todos los eventos del
//   finde no debe superar product.stock (aviso, no bloqueo).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  passwordHash  String
  role          String          @default("ARMADOR") // ADMIN | ARMADOR | LOGISTICA
  createdAt     DateTime        @default(now())
  movements     StockMovement[]
  notifications Notification[]  @relation("NotifRecipient")
  suggestions   Suggestion[]    @relation("SuggestionAuthor")
}

// Suscripción de un dispositivo a las notificaciones push (una por celular/navegador).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Aviso para un usuario ("Enrique actualizó el pedido de Puerto").
// Se crea uno por destinatario (todos menos quien hizo el cambio).
model Notification {
  id          String   @id @default(cuid())
  recipientId String
  recipient   User     @relation("NotifRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorName   String
  type        String // ORDER_EDIT
  message     String
  eventId     String?
  read        Boolean  @default(false)
  // `createdAt` se refresca con cada cambio: marca la ÚLTIMA actividad, y es lo
  // que usa el barrido para saber que la persona ya dejó de editar.
  createdAt   DateTime @default(now())
  // `sinceAt` NO se refresca: marca dónde arrancó esta tanda de cambios, y es
  // desde donde el resumen los lista.
  sinceAt     DateTime @default(now())
  changeCount Int      @default(1)
  // Null = el push todavía no salió. Se manda uno solo por tanda.
  pushedAt    DateTime?
  // A dónde lleva el aviso al tocarlo. Null = al resumen de cambios del pedido,
  // que era el único destino cuando esto se escribió.
  linkUrl     String?

  @@index([recipientId, read])
  @@index([recipientId, createdAt])
  @@index([type, pushedAt])
}

// Una sugerencia del equipo sobre la app: algo que falta, algo que molesta,
// algo que no anda. Es un canal de ida y vuelta, no una orden: nada de lo que
// se pide acá se aplica solo.
model Suggestion {
  id         String  @id @default(cuid())
  authorId   String
  author     User    @relation("SuggestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  // Se guarda el nombre además del vínculo: si el usuario se borra, la
  // sugerencia tiene que seguir diciendo quién la escribió.
  authorName String
  kind       String // AGREGAR | CAMBIAR | ELIMINAR | PROBLEMA | OTRO
  title      String
  body       String
  status     String  @default("NUEVA") // NUEVA | EN_REVISION | ACEPTADA | IMPLEMENTADA | DESCARTADA

  // Contexto: dónde estaba parada la persona y sobre qué escribía. Se arma solo
  // salvo `contextNote`, que lo escribe quien manda la sugerencia.
  screen      String?
  eventId     String?
  eventLugar  String?
  productId   String?
  contextNote String?

  // Datos técnicos para poder reproducir un problema. Nunca credenciales:
  // `device` es un resumen del navegador y el sistema, no el User-Agent crudo.
  appVersion String?
  device     String?

  // Respuesta de la administradora.
  reply         String?
  repliedAt     DateTime?
  repliedByName String?
  statusAt      DateTime?

  // Llave que manda el formulario, una por redacción. Es lo que hace que un
  // doble toque —o un reintento al volver la señal— no cree dos sugerencias.
  clientKey String   @unique
  createdAt DateTime @default(now())

  @@index([authorId, createdAt])
  @@index([status, createdAt])
}

// Qué se tocó exactamente en un pedido. Sin esto el aviso puede decir que algo
// cambió, pero no qué: hay que poder mirar el antes y el después.
model OrderChange {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actorId   String?
  actorName String
  itemName  String
  kind      String // AGREGADO | QUITADO | CANTIDAD | NOTA | COPIADO
  before    String?
  after     String?
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
}

model Product {
  id         String          @id @default(cuid())
  name       String
  category   String          // ENSERES | BEBIDA | MOBILIARIO
  rubro      String?
  type       String          // REUTILIZABLE | CONSUMIBLE
  unit       String          @default("Unidad")
  description String?        // aclaración opcional: para qué es, cómo distinguirlo
  stock      Int             @default(0) // solo aplica a reutilizables
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  movements  StockMovement[]
  orderLines OrderLine[]
  changes    ProductChange[]

  @@index([category])
}

// Historial de ajustes de stock (rotura / pérdida / compra / ajuste manual)
model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta     Int // + suma, - resta
  reason    String   // ROTURA | PERDIDA | COMPRA | AJUSTE
  note      String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

// Un fin de semana agrupa hasta ~11 eventos que comparten el mismo stock
model Weekend {
  id        String            @id @default(cuid())
  label     String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime          @default(now())
  // Borrar no destruye: se marca la fecha y el finde pasa a la papelera, de
  // donde se puede recuperar con sus eventos y pedidos intactos.
  deletedAt DateTime?
  events    Event[]
  snapshot  WeekendSnapshot?
  versions  WeekendVersion[]

  @@index([deletedAt])
}

// Copia recuperable de los pedidos de un finde. Se guarda ANTES de cualquier
// acción que los reemplace, para que descartar cambios no sea un camino de ida.
model WeekendVersion {
  id         String    @id @default(cuid())
  weekendId  String
  weekend    Weekend   @relation(fields: [weekendId], references: [id], onDelete: Cascade)
  kind       String // PRE_DESCARTE | PRE_RESTAURACION
  data       String // JSON de las líneas, mismo formato que WeekendSnapshot
  lineCount  Int       @default(0)
  actorId    String?
  actorName  String
  createdAt  DateTime  @default(now())
  restoredAt DateTime?

  @@index([weekendId, createdAt])
}

// Historial de modificaciones del catálogo: qué campo, quién y con qué valores.
// El stock NO va acá: sus cambios ya viven en StockMovement.
model ProductChange {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  actorId   String?
  actorName String
  field     String // nombre | descripcion | categoria | rubro | tipo | unidad | estado
  before    String?
  after     String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

// "Versión guardada" (checkpoint) de los pedidos de un fin de semana ya pasado.
// Permite descartar cambios accidentales y volver a este estado.
model WeekendSnapshot {
  id        String   @id @default(cuid())
  weekendId String   @unique
  weekend   Weekend  @relation(fields: [weekendId], references: [id], onDelete: Cascade)
  takenAt   DateTime @default(now())
  data      String // JSON: [{ eventId, productId, customName, customUnit, qty, note }]
}

model Event {
  id          String      @id @default(cuid())
  weekendId   String
  weekend     Weekend     @relation(fields: [weekendId], references: [id], onDelete: Cascade)
  lugar       String
  date        DateTime
  guests      Int         @default(0)
  responsable String?
  status      String      @default("NO_LISTO") // LISTO | NO_LISTO
  createdAt   DateTime    @default(now())
  // Ídem Weekend: el evento borrado va a la papelera con su pedido.
  deletedAt   DateTime?
  lines       OrderLine[]
  changes     OrderChange[]

  @@index([weekendId, deletedAt])
}

// Una línea de pedido dentro de un evento.
// Puede ser un producto del catálogo (productId) o un ítem suelto fuera de
// catálogo (customName, sin control de stock). Los ítems sueltos llevan su
// propia categoría (customCategory) para poder imprimirse en el pedido del
// sector correcto (Enseres/Bebida/Mobiliario), ya que no tienen producto.
model OrderLine {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  customName     String?
  customUnit     String?
  customCategory String? // ENSERES | BEBIDA | MOBILIARIO — solo para ítems sueltos
  qty            Int      @default(0)
  note           String?

  @@unique([eventId, productId])
}
