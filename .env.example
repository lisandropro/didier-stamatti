# Copiar a .env y completar. El .env no se versiona.

# Base de datos (SQLite). En producción apunta al volumen persistente.
DATABASE_URL="file:./dev.db"

# Firma de las sesiones. Mínimo 32 bytes; si falta o es corta, nadie puede entrar.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Avisos push (VAPID). Vacías = la app anda, pero no manda avisos al teléfono.
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:alguien@ejemplo.com"

# Contraseña del primer usuario administrador. Solo la usa `npm run db:seed`.
SEED_ADMIN_PASSWORD=""

# Respaldo diario a un bucket S3. Sin BACKUP_S3_BUCKET no se respalda (desarrollo).
# BACKUP_S3_BUCKET=""
# BACKUP_S3_ENDPOINT=""
# BACKUP_S3_REGION=""
# BACKUP_S3_ACCESS_KEY_ID=""
# BACKUP_S3_SECRET_ACCESS_KEY=""
# Para pedir un respaldo a mano por /api/internal/backup. Mínimo 32 bytes.
# BACKUP_TRIGGER_SECRET=""
